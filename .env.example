# Moonshot / Kimi API Key (or OPENAI_API_KEY / DASHSCOPE_API_KEY)
MOONSHOT_API_KEY=your-moonshot-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# DASHSCOPE_API_KEY=your-dashscope-api-key-here

# API Base URL (defaults to Moonshot API endpoint https://api.moonshot.cn/v1)
# Use https://api.moonshot.ai/v1 for global accounts
OPENAI_BASE_URL=https://api.moonshot.cn/v1

# Model Name (defaults to kimi-k2.7-code; or kimi-k3 / kimi-k2.6)
OPENAI_MODEL=kimi-k2.7-code

# Voice transcription model (optional)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# PYMOL_FLOW_WORKDIR=C:\path\to\pymol-flow-workdir
