# Alibaba Cloud DashScope / Qwen API Key (or OPENAI_API_KEY)
DASHSCOPE_API_KEY=sk-your-dashscope-key-here
# OPENAI_API_KEY=sk-your-openai-key-here

# API Base URL (defaults to Tongyi Qianwen Maas compatible endpoint)
OPENAI_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1

# Model Name (defaults to qwen3.8-flash with deep thinking support)
OPENAI_MODEL=qwen3.8-flash

# Voice transcription model (optional)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# PYMOL_FLOW_WORKDIR=C:\path\to\pymol-flow-workdir
